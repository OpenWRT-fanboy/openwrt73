From 4d37c628b2ce8b9004b85df5d20f3d740bf65bbc Mon Sep 17 00:00:00 2001
From: mathewb64 <mathewblowers@gmail.com>
Date: Tue, 10 Feb 2026 16:20:24 +0000
Subject: [PATCH] overlays: Add nospi10

Add an overlay so spi10 can be disabled on Raspberry Pi 5. This allows the
firmware to continue to access EEPROM after boot so that AB firmware
updates can be performed.

Signed-off-by: Mathew Blowers <mathew.blowers@raspberrypi.com>
---
 arch/arm/boot/dts/overlays/Makefile            |  1 +
 arch/arm/boot/dts/overlays/README              |  6 ++++++
 arch/arm/boot/dts/overlays/nospi10-overlay.dts | 13 +++++++++++++
 3 files changed, 20 insertions(+)
 create mode 100644 arch/arm/boot/dts/overlays/nospi10-overlay.dts

--- /dev/null
+++ b/arch/arm/boot/dts/overlays/nospi10-overlay.dts
@@ -0,0 +1,13 @@
+/dts-v1/;
+/plugin/;
+
+/ {
+	compatible = "brcm,bcm2712";
+
+	fragment@0 {
+		target = <&spi10>;
+		__overlay__ {
+			status = "disabled";
+		};
+	};
+};
